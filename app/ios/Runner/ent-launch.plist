<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.io.github.ccch1mneyyy.dshgo</string>
	</array>
	<!-- 读屏与点按靠 HID 授权；打开其它 App 靠 launchapplications。
	     刻意不含 com.apple.private.security.no-sandbox：带上它的包在
	     XinaA15 上会被 TrollStore 直接拒绝安装，连旧版一起卸掉。
	     launchapplications 本身是 SpringBoard 侧的授权，不需要跳出沙盒。 -->
	<key>com.apple.private.hid.client.event-dispatch</key>
	<true/>
	<key>com.apple.springboard.launchapplications</key>
	<true/>
</dict>
</plist>
